# 推荐：把 Key 放在系统环境变量里，不要写进项目
#   Windows:  setx DEEPSEEK_API_KEY "sk-你的key"   （重开终端/IDEA 生效）
#
# 如果一定要放文件里：复制本文件为 .env（已被 .gitignore 忽略），再取消下一行注释
# DEEPSEEK_API_KEY=sk-你的key

# 可选：换服务商 / 模型（任何 OpenAI 兼容接口）
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 可选：接 STM32 时打开
# CRT_SERIAL_ENABLED=true
# CRT_SERIAL_PORT=auto

# 可选：接口保护
# CRT_API_KEY=你的访问口令          # 配置后 /api/** 需要 X-API-Key，留空则不启用
# CRT_MAX_TEXT_LENGTH=2000          # 单条需求最大字数
# CRT_RATE_LIMIT=10                 # 每个 IP 每窗口最多请求次数
# CRT_RATE_WINDOW=60                # 限流窗口（秒）
